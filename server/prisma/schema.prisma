// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  username    String
  createdAt   DateTime     @default(now())
  memories    Memory[]
  memoryCards MemoryCard[]

  // Client-side encryption wrapping bundle. All null until the user sets up a
  // passphrase. The server stores these but cannot read user data with them.
  // Salts and wrapped DEKs/IVs are base64 strings. See encryption-guide.html.
  crypto_version            Int?
  passphrase_salt           String?
  recovery_salt             String?
  wrapped_dek_passphrase    String?
  wrapped_dek_passphrase_iv String?
  wrapped_dek_recovery      String?
  wrapped_dek_recovery_iv   String?
}

model Memory {
  id           String       @id @default(uuid())
  user         User         @relation(fields: [user_id], references: [id])
  user_id      String
  created_at   DateTime     @default(now())
  date         DateTime     @db.Date
  memory_cards MemoryCard[]

  @@unique([user_id, date]) //so each user can only have one memory per day
}

model MemoryCard {
  type    ContentType
  content String //ciphertext (TEXT) or an S3 key (media); disambiguated by type
  // IV used to encrypt `content`. Null = legacy plaintext (not yet encrypted).
  content_iv String?
  id      String      @id @default(uuid())
  date    DateTime
  // render data: { position: { x, y }, size: { width, height }, zIndex }
  // future card features (font, fontSize, color, ...) live here too
  style   Json

  user      User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id   String
  memory    Memory @relation(fields: [memory_id], references: [id], onDelete: Cascade)
  memory_id String
}

enum ContentType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
}
